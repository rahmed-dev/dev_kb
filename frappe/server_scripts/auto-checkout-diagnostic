# Auto-checkout diagnostic — why did a checkin not get its system OUT?
#
# Read-only. Writes what it found to an Error Log row, because a Server Script
# has nowhere else to print: `print()` goes to the worker's stdout and is lost.
#
# Set EMPLOYEE and SHIFT before running. Both are examples, not defaults — a
# diagnostic that quietly reports on somebody else's record is worse than one
# that fails.

EMPLOYEE = "HR-EMP-00001"
SHIFT = "Regular Shift"

now = frappe.utils.now_datetime()
# 30 hours, not 24: a night shift's IN is on the previous calendar day, and a
# 24-hour window drops exactly the shift this script exists to explain.
window_start = frappe.utils.add_to_date(now, hours=-30)

output = []
output.append(f"now = {now}")
output.append(f"window_start = {window_start}")

# Step 1: the INs the auto-checkout job itself would have picked up. Same filter,
# so a mismatch between this list and expectation IS the answer.
in_records = frappe.db.get_all(
    "Employee Checkin",
    filters={
        "log_type": "IN",
        "custom_is_system_generated": 0,
        "time": [">=", window_start],
    },
    fields=["name", "employee", "shift", "time", "custom_is_system_generated"],
    ignore_permissions=True,
)
output.append(f"--- Filter returned {len(in_records)} IN records ---")
for r in in_records:
    output.append(f"  {r.name} | {r.employee} | shift={r.shift} | time={r.time} | sysgen={r.custom_is_system_generated}")

# Step 2: one employee's INs, straight from the table. Raw SQL on purpose — it
# sees rows a permission-filtered read would hide, which is one of the answers.
output.append(f"--- {EMPLOYEE} IN records (raw) ---")
employee_in = frappe.db.sql("""
    SELECT name, employee, log_type, shift, shift_start, shift_end,
           time, custom_is_system_generated
    FROM `tabEmployee Checkin`
    WHERE employee = %(employee)s AND log_type = 'IN'
    ORDER BY time DESC
    LIMIT 3
""", {"employee": EMPLOYEE}, as_dict=True)
for r in employee_in:
    output.append(f"  {r}")

# Step 3: and the OUTs, to see whether one was generated at all.
output.append(f"--- {EMPLOYEE} OUT records ---")
employee_out = frappe.db.sql("""
    SELECT name, time, custom_is_system_generated
    FROM `tabEmployee Checkin`
    WHERE employee = %(employee)s AND log_type = 'OUT'
    ORDER BY time DESC
    LIMIT 3
""", {"employee": EMPLOYEE}, as_dict=True)
for r in employee_out:
    output.append(f"  {r}")

# Step 4: the shift's own configuration. Auto attendance being off here is the
# single most common reason nothing happened.
output.append(f"--- {SHIFT} config ---")
shift = frappe.db.get_value(
    "Shift Type",
    SHIFT,
    ["start_time", "end_time", "enable_auto_attendance"],
    as_dict=True,
)
output.append(f"  {shift}")

frappe.log_error(
    title="Auto-Checkout Diagnostic",
    message="\n".join(output)
)
